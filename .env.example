# Copy this file to .env.local if you need to override any of these.
# Not needed for `npm run dev` or `npm run dev:all` — same-origin requests work
# without it. Only needed when the frontend is deployed separately from its
# backend (e.g. GitHub Pages + a Cloudflare Worker).

# Base URL of the backend (Vercel function / Cloudflare Worker) to send
# /api/scrape and /api/fetch-recipe requests to. Leave unset for same-origin.
# VITE_API_BASE=https://trusted-recipe-finder-api.<account>.workers.dev

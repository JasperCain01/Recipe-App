# Copy this file to .env.local if you need to override any of these.
# Only needed when the frontend is deployed separately from its backend
# (e.g. GitHub Pages + the Cloudflare Worker).

# Base URL of the Cloudflare Worker to send /api/scrape and /api/fetch-recipe
# requests to. Leave unset for same-origin (e.g. wrangler dev proxying).
# VITE_API_BASE=https://trusted-recipe-finder-api.<account>.workers.dev
